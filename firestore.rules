rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ヘルパー関数 ──────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    function hasRole(companyId, role) {
      return role in getUserData(companyId).roles;
    }

    function isAdmin(companyId) {
      return hasRole(companyId, 'admin');
    }

    // 社会保険管理のログインは関数（authLogin など）を通し、トークンにセッション番号（sid）が付く。
    // Firebase に直接ログインしたトークン（ロック・セッションの期限を飛ばしたもの）は読み書きさせない
    function hasSession() {
      return request.auth.token.sid is string;
    }

    function isLoginEnabled(companyId) {
      return hasSession() && getUserData(companyId).isLoginDisabled != true;
    }

    function isNotSuspended(companyId) {
      return hasSession() && getUserData(companyId).isSuspended != true;
    }

    function isActiveUser(companyId) {
      let user = getUserData(companyId);
      return hasSession() && user.isSuspended != true && user.isLoginDisabled != true;
    }

    function isAdminRole(companyId) {
      let user = getUserData(companyId);
      return 'admin' in user.roles
          || 'operator' in user.roles
          || 'approver' in user.roles
          || 'viewer' in user.roles;
    }

    function hasWriteRole(companyId) {
      let user = getUserData(companyId);
      return 'admin' in user.roles || 'operator' in user.roles;
    }

    function isOfficeAllowed(companyId, officeId) {
      let user = getUserData(companyId);
      return 'admin' in user.roles
          || (user.officeIds != null
              && user.officeIds.size() > 0
              && officeId in user.officeIds);
    }

    function getEmployeeData(companyId, employeeId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data;
    }

    function isSelf(companyId, employeeId) {
      return getEmployeeData(companyId, employeeId).userId == request.auth.uid;
    }

    // ── companies ─────────────────────────────────────

    match /companies/{companyId} {
      allow read: if isAuthenticated() && isActiveUser(companyId);
      allow write: if isAuthenticated() && isActiveUser(companyId)
                   && isAdmin(companyId);

      // ── マスタ系（offices / departments / insuranceRates）──

      match /offices/{officeId} {
        allow read: if isAuthenticated() && isActiveUser(companyId);
        allow write: if isAuthenticated() && isActiveUser(companyId)
                     && isAdmin(companyId);
      }

      match /departments/{departmentId} {
        allow read: if isAuthenticated() && isActiveUser(companyId);
        allow write: if isAuthenticated() && isActiveUser(companyId)
                     && isAdmin(companyId);
      }

      match /insuranceRates/{rateId} {
        allow read: if isAuthenticated() && isActiveUser(companyId);
        allow write: if isAuthenticated() && isActiveUser(companyId)
                     && isAdmin(companyId);
      }

      // ── employees ───────────────────────────────────

      match /employees/{employeeId} {
        allow read: if isAuthenticated() && isLoginEnabled(companyId)
          && (
            (isActiveUser(companyId) && isAdmin(companyId))
            || (isActiveUser(companyId)
                && isAdminRole(companyId)
                && isOfficeAllowed(companyId, resource.data.officeId))
            || resource.data.userId == request.auth.uid
          );
        allow create: if isAuthenticated() && isActiveUser(companyId)
          && hasWriteRole(companyId);
        allow update: if isAuthenticated() && isActiveUser(companyId)
          && (isAdmin(companyId)
              || (hasRole(companyId, 'operator')
                  && isOfficeAllowed(companyId, resource.data.officeId)))
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['deletedAt']);
        allow delete: if false;

        // secrets: クライアントからの直接アクセスを全面禁止
        match /secrets/{secretId} {
          allow read, write: if false;
        }

        // ── dependents ──────────────────────────────

        match /dependents/{dependentId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdmin(companyId))
              || (isActiveUser(companyId)
                  && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && (isAdmin(companyId)
                || (hasRole(companyId, 'operator')
                    && isOfficeAllowed(companyId,
                        getEmployeeData(companyId, employeeId).officeId)));
          allow delete: if false;
        }

        // ── employments ─────────────────────────────

        match /employments/{employmentId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;
        }

        // ── grades ──────────────────────────────────

        match /grades/{gradeId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;
        }

        // ── salaries ────────────────────────────────

        match /salaries/{salaryId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;

          match /revisions/{revisionId} {
            allow read: if isAuthenticated() && isActiveUser(companyId)
              && (isAdmin(companyId) || hasRole(companyId, 'approver'));
            allow write: if isAuthenticated() && isActiveUser(companyId)
              && isAdmin(companyId);
            allow delete: if false;
          }
        }

        // ── bonuses ─────────────────────────────────

        match /bonuses/{bonusId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;

          match /revisions/{revisionId} {
            allow read: if isAuthenticated() && isActiveUser(companyId)
              && (isAdmin(companyId) || hasRole(companyId, 'approver'));
            allow write: if isAuthenticated() && isActiveUser(companyId)
              && isAdmin(companyId);
            allow delete: if false;
          }
        }

        // ── monthlyInsurance ────────────────────────

        match /monthlyInsurance/{monthId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;

          match /revisions/{revisionId} {
            allow read: if isAuthenticated() && isActiveUser(companyId)
              && (isAdmin(companyId) || hasRole(companyId, 'approver'));
            allow write: if isAuthenticated() && isActiveUser(companyId)
              && isAdmin(companyId);
            allow delete: if false;
          }
        }

        // ── bonusInsurance ──────────────────────────

        match /bonusInsurance/{bonusInsuranceId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;
        }

        // ── premiumCollections ───────────────────────

        match /premiumCollections/{collectionId} {
          allow read: if isAuthenticated() && isActiveUser(companyId)
            && isAdminRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;
        }

        // ── premiumExemptions ───────────────────────

        match /premiumExemptions/{exemptionId} {
          allow read: if isAuthenticated() && isActiveUser(companyId)
            && (isAdmin(companyId)
                || hasRole(companyId, 'approver')
                || hasRole(companyId, 'viewer')
                || (hasRole(companyId, 'operator')
                    && isOfficeAllowed(companyId,
                        getEmployeeData(companyId, employeeId).officeId)));
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && (isAdmin(companyId)
                || (hasRole(companyId, 'operator')
                    && isOfficeAllowed(companyId,
                        getEmployeeData(companyId, employeeId).officeId)));
          allow delete: if false;
        }

        // ── leaves ──────────────────────────────────

        match /leaves/{leaveId} {
          allow read: if isAuthenticated() && isLoginEnabled(companyId)
            && (
              (isActiveUser(companyId) && isAdminRole(companyId)
                  && isOfficeAllowed(companyId,
                      getEmployeeData(companyId, employeeId).officeId))
              || getEmployeeData(companyId, employeeId).userId == request.auth.uid
            );
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;
        }

        // ── filings ─────────────────────────────────

        match /filings/{filingId} {
          allow read: if isAuthenticated() && isActiveUser(companyId)
            && isAdminRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow write: if isAuthenticated() && isActiveUser(companyId)
            && hasWriteRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow delete: if false;
        }

        // ── approvalRequests ────────────────────────

        match /approvalRequests/{requestId} {
          allow read: if isAuthenticated() && isActiveUser(companyId)
            && isAdminRole(companyId);
          allow create: if isAuthenticated() && isActiveUser(companyId)
            && (isAdmin(companyId)
                || hasRole(companyId, 'approver')
                || hasRole(companyId, 'operator'));
          allow update: if isAuthenticated() && isActiveUser(companyId)
            && (isAdmin(companyId) || hasRole(companyId, 'approver'));
          allow delete: if false;
        }

        // ── transferHistory（異動履歴、読み取り専用）──

        match /transferHistory/{historyId} {
          allow read: if isAuthenticated() && isActiveUser(companyId)
            && isAdminRole(companyId)
            && isOfficeAllowed(companyId,
                getEmployeeData(companyId, employeeId).officeId);
          allow write: if false;
        }
      }

      // ── auditLogs（監査ログ、クライアント書き込み禁止）──

      match /auditLogs/{logId} {
        allow read: if isAuthenticated() && isActiveUser(companyId)
          && isAdmin(companyId);
        allow write: if false;
      }

      // ── employeeNumbers（社員番号予約、クライアント書き込み禁止）──

      match /employeeNumbers/{number} {
        allow read: if isAuthenticated() && isActiveUser(companyId)
          && hasWriteRole(companyId);
        allow write: if false;
      }

      // ── employeeRequests（冪等性キー、クライアント書き込み禁止）──

      match /employeeRequests/{requestId} {
        allow read: if false;
        allow write: if false;
      }

      // ── users ─────────────────────────────────────

      match /users/{userId} {
        allow read: if isAuthenticated() && isLoginEnabled(companyId)
          && (isAdmin(companyId) || request.auth.uid == userId);
        allow create: if isAuthenticated() && isActiveUser(companyId)
          && isAdmin(companyId);
        allow update: if isAuthenticated() && isActiveUser(companyId)
          && isAdmin(companyId)
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['roles']);
        allow delete: if false;
      }

      // ── sessions（ログイン中の端末。本人が自分のものだけ読める。書くのは関数だけ）──

      match /sessions/{sessionId} {
        allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // loginGuards・userSecrets・myNumberAccessLogs は関数だけが扱う（ここに match がないので読み書きできない）

      // ── invitations ───────────────────────────────

      match /invitations/{invitationId} {
        allow read, write: if isAuthenticated()
          && isActiveUser(companyId)
          && isAdmin(companyId);
        allow delete: if false;
      }
    }

    // ── 課題管理アプリ（task-app）────────────────────
    // 同じ Firebase プロジェクトで課題管理アプリも動かしているため、そのルールをここに統合する。
    // 元は task-app/firestore.rules。task-app のルールを変えたら、両方をそろえること。

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('disabled', false) == false;
    }

    function isManager() {
      return isActiveMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'manager';
    }

    function validUid(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['uid', 'name', 'role', 'weeklyCapacityHours', 'avatarColor'])
        && data.keys().hasOnly(['uid', 'name', 'role', 'weeklyCapacityHours', 'avatarColor', 'disabled', 'theme', 'displayName', 'photoURL', 'fcmToken', 'leaves', 'weeklyCapacity'])
        && validUid(data.uid)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.role in ['member', 'manager']
        && data.weeklyCapacityHours is number && data.weeklyCapacityHours > 0 && data.weeklyCapacityHours <= 168
        && data.avatarColor is string && data.avatarColor.size() <= 64
        && data.get('disabled', false) is bool
        && (!('theme' in data) || (data.theme is string && data.theme.size() <= 64))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 4096))
        && (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 4096))
        && (!('leaves' in data) || (data.leaves is list && data.leaves.size() <= 2000))
        && (!('weeklyCapacity' in data) || (data.weeklyCapacity is number && data.weeklyCapacity > 0 && data.weeklyCapacity <= 168));
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /members/{memberId} {
      allow get: if isActiveMember() || (isSignedIn() && request.auth.uid == memberId);
      allow list: if isActiveMember();
      allow create: if isSignedIn()
                    && request.auth.uid == memberId
                    && isValidMember(request.resource.data)
                    && request.resource.data.uid == memberId
                    && request.resource.data.role == 'member'
                    && request.resource.data.get('disabled', false) == false;
      allow update: if isManager() && isValidMember(request.resource.data)
                    && request.resource.data.uid == resource.data.uid;
      allow update: if isActiveMember() && isValidMember(request.resource.data)
                    && request.auth.uid == memberId
                    && request.resource.data.uid == resource.data.uid
                    && onlyChanges(['name', 'displayName', 'theme', 'weeklyCapacityHours', 'weeklyCapacity', 'photoURL', 'fcmToken', 'leaves']);
      // Keep disabled records so the same account cannot register again.
      allow delete: if false;

      // Personal display order: only the active owner can read or write it.
      // { taskIds: unique list (max 3000), updatedAt: server timestamp }
      match /taskOrders/{scope} {
        function isValidTaskOrder(data) {
          return data.keys().hasAll(['taskIds', 'updatedAt'])
            && data.keys().hasOnly(['taskIds', 'updatedAt'])
            && data.taskIds is list && data.taskIds.size() <= 3000
            && data.taskIds.toSet().size() == data.taskIds.size()
            && data.updatedAt is timestamp && data.updatedAt == request.time
            && (scope in ['root:未着手', 'root:進行中', 'root:完了']
              || scope.matches('children:[A-Za-z0-9_-]{1,128}'));
        }
        allow read, delete: if isActiveMember() && request.auth.uid == memberId;
        allow create, update: if isActiveMember() && request.auth.uid == memberId
          && isValidTaskOrder(request.resource.data);
      }

      match /notifications/{notifId} {
        allow read: if isActiveMember()
                    && (request.auth.uid == memberId || isManager());
        allow create: if isActiveMember();
        allow update: if isActiveMember() && request.auth.uid == memberId;
        allow delete: if isActiveMember()
                      && (request.auth.uid == memberId || isManager());
      }
    }

    match /tasks/{taskId} {
      function isValidTaskIdentity(data) {
        return 'createdBy' in data && (data.createdBy == null || validUid(data.createdBy))
          && (data.get('recurrencePreviousTaskId', null) == null || validUid(data.recurrencePreviousTaskId));
      }
      function validRecurrenceCreator(data) {
        let previous = get(/databases/$(database)/documents/tasks/$(data.recurrencePreviousTaskId)).data;
        return previous.status in ['完了', 'アーカイブ済み']
          && previous.recurrence != null
          && (isManager() || previous.createdBy == request.auth.uid || previous.assigneeId == request.auth.uid)
          && data.createdBy == previous.createdBy
          && data.recurrence == previous.recurrence
          && data.recurrenceSourceId == (previous.get('recurrenceSourceId', null) == null ? data.recurrencePreviousTaskId : previous.recurrenceSourceId)
          && data.title == previous.title
          && data.assigneeId == previous.assigneeId
          && data.parentId == previous.parentId
          && data.estimatedHours == previous.estimatedHours
          && data.status == '未着手';
      }
      function taskExistsAfterWrite() {
        return existsAfter(/databases/$(database)/documents/tasks/$(taskId));
      }
      function validParent(data) {
        return data.get('parentId', null) == null
          || (data.parentId != taskId && existsAfter(/databases/$(database)/documents/tasks/$(data.parentId)));
      }
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isValidTaskIdentity(request.resource.data)
        && !exists(/databases/$(database)/documents/taskDeletionMarkers/$(taskId))
        && (request.resource.data.createdBy == request.auth.uid
          || (request.resource.data.get('recurrencePreviousTaskId', null) != null && validRecurrenceCreator(request.resource.data)))
        && validParent(request.resource.data);
      allow update: if isActiveMember() && isValidTaskIdentity(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && validParent(request.resource.data);
      // Task trees are deleted only through deleteTaskSafely, which checks every
      // task's manager/creator/assignee and commits all record deletions atomically.
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isActiveMember();
        allow create: if isActiveMember() && taskExistsAfterWrite()
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if isActiveMember() && taskExistsAfterWrite()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isActiveMember()
                      && resource.data.authorId == request.auth.uid;
      }

      match /attachments/{attachmentId} {
        // Immutable attachment records. New files live under the author's UID.
        function isValidAttachment(data) {
          return data.keys().hasAll(['taskId', 'fileName', 'fileType', 'fileSize', 'dataUrl', 'storagePath', 'authorId', 'authorName', 'createdAt'])
            && data.keys().hasOnly(['taskId', 'fileName', 'fileType', 'fileSize', 'dataUrl', 'storagePath', 'authorId', 'authorName', 'createdAt'])
            && data.taskId == taskId
            && data.authorId == request.auth.uid
            && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 1024
            && data.fileType is string && data.fileType.size() <= 256
            && data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 10 * 1024 * 1024
            && data.dataUrl is string && data.dataUrl.size() <= 8192
            && data.authorName is string && data.authorName.size() <= 256
            && data.createdAt == request.time
            && data.storagePath is string && data.storagePath.size() <= 2048
            && data.storagePath.split('/').size() == 4
            && data.storagePath.split('/')[0] == 'task-attachments'
            && data.storagePath.split('/')[1] == taskId
            && data.storagePath.split('/')[2] == request.auth.uid
            && data.storagePath.split('/')[3].size() > 0;
        }
        allow read: if isActiveMember();
        allow create: if isActiveMember() && taskExistsAfterWrite() && isValidAttachment(request.resource.data);
        allow delete: if isActiveMember() && resource.data.authorId == request.auth.uid;
      }

      // Legacy files have no UID in their path. Claims are verified against
      // the original immutable attachment, and cannot be changed or deleted.
      match /attachmentOwners/{fileName} {
        function isValidLegacyOwner(data) {
          let attachment = get(/databases/$(database)/documents/tasks/$(taskId)/attachments/$(data.attachmentId)).data;
          return data.keys().hasAll(['attachmentId', 'authorId'])
            && data.keys().hasOnly(['attachmentId', 'authorId'])
            && data.attachmentId is string && data.attachmentId.size() > 0 && data.attachmentId.size() <= 128
            && data.authorId == request.auth.uid
            && attachment.authorId == request.auth.uid
            && attachment.storagePath == 'task-attachments/' + taskId + '/' + fileName;
        }
        allow read: if isActiveMember();
        allow create: if isActiveMember() && taskExistsAfterWrite() && isValidLegacyOwner(request.resource.data);
      }

      match /activities/{activityId} {
        allow read: if isActiveMember();
        allow create: if isActiveMember() && taskExistsAfterWrite() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isActiveMember();
      }
    }

    // Server-only manifests and permanent markers prevent ID reuse while
    // asynchronous cleanup still owns paths belonging to a deleted task.
    match /taskDeletionJobs/{jobId} {
      allow read: if isActiveMember() && (resource.data.requestedBy == request.auth.uid || isManager());
      allow write: if false;
    }
    match /taskDeletionMarkers/{taskId} {
      allow read, write: if false;
    }

    match /teamSettings/{docId} {
      allow read: if isActiveMember();
      allow write: if isManager();
    }

    match /taskTemplates/{templateId} {
      function isValidTemplateIdentity(data) {
        return 'createdBy' in data && validUid(data.createdBy);
      }
      allow read: if isActiveMember() && resource.data.createdBy == request.auth.uid;
      allow create: if isActiveMember() && isValidTemplateIdentity(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActiveMember() && isValidTemplateIdentity(request.resource.data)
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isActiveMember() && resource.data.createdBy == request.auth.uid;
    }
  }
}
