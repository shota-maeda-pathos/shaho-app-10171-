{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Angular: local server",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/start-local.cjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NO_COLOR": "1",
          "FORCE_COLOR": "0",
          "NG_CLI_ANALYTICS": "false"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^(.+\\.ts)\\((\\d+),(\\d+)\\): error (TS\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "Local:.*http://localhost:4200/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
